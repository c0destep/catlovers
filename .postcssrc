{
  "plugins": {
    "@fullhuman/postcss-purgecss": {
      "content": [
        "./*.html",
        "./**/*.html",
        "./js/**/*.js",
        "./includes/**/*.html"
      ],
      "dynamicAttributes": [
        "data-theme"
      ],
      "safelist": [
        "animate-on-scroll",
        "is-visible",
        "stagger-children",
        "skip-link",
        "sr-only",
        "page-background",
        "text-gradient",
        "is-invalid",
        "cat-fact",
        "error-page",
        "menu__link--active",
        "html",
        "body"
      ]
    }
  }
}
