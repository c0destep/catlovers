{
  "name": "catlovers",
  "version": "1.0.0",
  "description": "A website for cat lovers",
  "keywords": [
    "HTML",
    "CSS",
    "Cat",
    "Lovers"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "pnpm": "^11.0.0"
  },
  "author": {
    "name": "Lucas Alves",
    "email": "lucas.alves.capristrano59@gmail.com"
  },
  "scripts": {
    "build": "vite build && node scripts/prepare-pwa.mjs && node scripts/validate-build.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "images": "node scripts/generate-images.mjs",
    "test:e2e": "pnpm test:e2e:run",
    "test:e2e:open": "cypress open",
    "test:e2e:run": "cypress run --browser chrome",
    "test:i18n": "node scripts/validate-i18n.js",
    "lint": "eslint js/ && stylelint css/",
    "test": "pnpm test:i18n && pnpm test:e2e:run",
    "check": "pnpm lint && pnpm test:i18n && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/lora": "^5.3.0"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "ajv": "^8.20.0",
    "cypress": "^16.1.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "minimatch": "^10.2.6",
    "neostandard": "0.14.0-next",
    "postcss": "^8.5.28",
    "posthtml": "^0.16.7",
    "posthtml-include": "^2.0.1",
    "process": "^0.11.10",
    "sharp": "^0.33.5",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.0",
    "vite-plugin-html-include": "^1.5.2"
  },
  "onlyBuiltDependenciesList": [
    "@firebase/util",
    "@parcel/watcher",
    "@swc/core",
    "lmdb",
    "msgpackr-extract",
    "protobufjs",
    "sharp",
    "cypress"
  ]
}
